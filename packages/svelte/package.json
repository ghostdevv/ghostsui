{
	"name": "@ghostsui/svelte",
	"version": "1.0.0-beta.3",
	"type": "module",
	"scripts": {
		"build": "svelte-package --input src",
		"dev": "pnpm build --watch",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "publint"
	},
	"keywords": [
		"svelte"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ghostdevv/ghostsui.git",
		"directory": "packages/svelte"
	},
	"bugs": {
		"url": "https://github.com/ghostdevv/ghostsui/issues"
	},
	"homepage": "https://ui.ghostdev.xyz",
	"author": {
		"name": "Willow (GHOST)",
		"url": "https://ghostdev.xyz"
	},
	"license": "MIT",
	"files": [
		"dist",
		"CHANGELOG.md",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./modal": {
			"types": "./dist/modal/index.d.ts",
			"svelte": "./dist/modal/index.js"
		},
		"./toasts": {
			"types": "./dist/toasts/index.d.ts",
			"svelte": "./dist/toasts/index.js"
		},
		"./password": {
			"types": "./dist/password/index.d.ts",
			"svelte": "./dist/password/index.js"
		}
	},
	"peerDependencies": {
		"ghostsui": "workspace:^",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.7",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"publint": "^0.3.17",
		"svelte": "^5.53.5",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"melt": "^0.44.0"
	}
}
